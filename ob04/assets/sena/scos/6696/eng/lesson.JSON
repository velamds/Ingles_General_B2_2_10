_override": 1, "type": "RSLT", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "DWS", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "engenn10le10ob04re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Where's a good place for a first date in your city?", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "id": 1, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn10le10ob04re2aud01", "coverimg": "engenn10le10ob04re2img01.jpg", "images": [{"image": "engenn10le10ob04re2img01.jpg", "text": "", "id": 0, "time": "0"}, {"image": "engenn10le10ob04re2img01.jpg", "text": "<span class=\"strong\">Peter</span>:  So I think I found someone I like.\n</br><span class=\"strong\">Vanessa</span>: Good for you. Is she introverted or extroverted?\n</br><span class=\"strong\">Peter</span>: Well, she describes herself as fun-loving, light hearted and upbeat.\nHowever, she also claims that she is quite introverted and doesn't need to be the life of the party.\n</br><span class=\"strong\">Vanessa</span>: Which does she like better shy guys or outgoing guys?\n</br><span class=\"strong\">Peter</span>: She says shy is ok. She also likes guys who are reliable, intelligent and have a good sense of humor. We laugh at each others jokes and her humor is very self-effacing which I like.\n</br><span class=\"strong\">Vanessa</span>: Cool!", "id": 1, "time": "100"}, {"image": "engenn10le10ob04re2img02.jpg", "text": "<span class=\"strong\">Peter</span>: She's also completely into comic books and we had a long conversation about superheroes.\n</br><span class=\"strong\">Vanessa</span>: I love it when nerds unite. Does she like Batman or Superman?\n</br><span class=\"strong\">Peter</span>: I'll have you know she likes Superman, Batman, and the Flash.\n</br><span class=\"strong\">Vanessa</span>: Well. She's a keeper.\n</br><span class=\"strong\">Peter</span>: I utterly love her writing. It's so descriptive, and elegant while at the same time conversational.\n</br><span class=\"strong\">Vanessa</span>: She sounds great. What does she look like? Does she have blonde hair or brown hair?\n</br><span class=\"strong\">Peter</span>: I truly don't know. She didn't have a picture up on her profile.\n</br><span class=\"strong\">Vanessa</span>: That's ok. But she knows what you look like right?\n</br><span class=\"strong\">Peter</span>: No, I took down all my pictures. I prefer to be a man of mystery.", "id": 2, "time": "33000"}, {"image": "engenn10le10ob04re2img05.jpg", "text": "<span class=\"strong\">Vanessa</span>: With your dating record it should be man of misery.  What's her name?\n</br><span class=\"strong\">Peter</span>: I don't know her name.\n</br><span class=\"strong\">Vanessa</span>: What's her profile name?\n</br><span class=\"strong\">Peter</span>: Her name is SWEETGIRL. Cool, huh?\n</br><span class=\"strong\">Vanessa</span>: Oh yeah. So, when are you guys going to meet?\n</br><span class=\"strong\">Peter</span>: We are talking about getting together, but we haven't made a plan yet. We were thinking Wednesday for lunch, Thursday for dinner or something on Friday night.\n</br><span class=\"strong\">Vanessa</span>: Maybe bring her by the Bistro on Friday. I'll bend over backwards to make you look like a big shot.\n</br><span class=\"strong\">Peter</span>: Good idea! I'll text her and set it up.", "id": 3, "time": "76200"}]}}], "_data": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "A Comedy of Errors", "type": "lesson_name"}, {"content": "Meeting in Real Life", "type": "unit_name"}, {"content": 4, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 10, "type": "lesson"}, {"content": "B2.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Understand detailed descriptions of real or imaginary events and experiences in present, past or future and in spoken or written texts.", "type": "primary"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_1"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_2"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_3"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_4"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_5"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_6"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_7"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_8"}]}, {"content": "engenn10le10ob04re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Contrastive Stress", "type": "heading"}, {"content": "Intonation in English can be used to highlight certain parts of speech, to emphasize new information, or to contrast information. The words or phrases you choose to stress can provide added meaning to the sentence.", "type": "describer"}, {"content": "Contrastive stress is used to point out the difference between one object and another. Contrastive stress tends to be used with determiners such as '<span class=\"italic\">this, that, these </span>and<span class=\"italic\"> those</span>'. </br></br>Example:</br> <span class=\"italic\"> Does she like <span class=\"strong\">Batman </span>or<span class=\"strong\"> Superman</span>?</br> Does she have <span class=\"strong\">blonde</span> hair or <span class=\"strong\">brown </span>hair? </br>I think I prefer <span class=\"strong\">this</span> online profile.</span>", "type": "text"}, {"content": "Is she introverted or extroverted?", "type": "example"}, {"content": "Does she like Batman or Superman?", "type": "example"}, {"content": "Does she have blonde hair or brown hair?", "type": "example"}, {"content": "Is she tall or short?", "type": "example"}, {"content": "Do you prefer this one or that one?", "type": "example"}, {"content": "Did you hear that she actually turned down the job?", "type": "example"}, {"content": "They had twins! Can you imagine!", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Intonation in Choice Questions", "type": "heading"}, {"content": "All choice questions have an 'or' in them. They are either open or closed. You use different intonation patterns for open and closed questions. They also require different kinds of answers.", "type": "describer"}, {"content": "You can  think of  an open choice question as a yes or no question. There are two possible intonation patterns.  </br></br>For example:</br> Does she like <span class=\"strong\">Batman</span> \u2197or <span class=\"strong\">Superman </span>\u2197? </br>Does she like <span class=\"strong\">Bat</span>man or <span class=\"strong\">Super</span>man \u2197?", "type": "text"}, {"content": "In this case, the possible answers could be yes or no answers: </br><span class=\"italic\">Yes, she likes Batman.</br> Yes, she likes both. </br>No, she doesn't like either. </br>No, but she likes Spiderman.</span>", "type": "text"}, {"content": " A closed choice question has limited choices. It cannot be answered by yes or no answers, and implies a choice between one option or the other.</br></br>For example: </br>Does she like <span class=\"strong\">Batman </span>\u2197 or <span class=\"strong\">Superman</span>\u2198?", "type": "text"}, {"content": "In the case, the possible answers could be: </br><span class=\"italic\">She likes Batman. </br>She likes Superman.</br> She likes both.</br> Neither.</span>", "type": "text"}, {"content": "Does she have blonde hair or brown hair?", "type": "example"}, {"content": " Is she introverted or extroverted?", "type": "example"}, {"content": "Does she like shy guys or outgoing guys better?", "type": "example"}, {"content": "Does she like tall guys or short guys?", "type": "example"}, {"content": "Is he into rock music or classical music?", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "introverted", "type": "name"}, {"content": "a shy person", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: She doesn't really like meeting people. She is very introverted.", "type": "example"}, {"content": "engenn10le10ob04aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use when you meet someone.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "hilarious", "type": "name"}, {"content": "very funny", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: My dad is hilarious. He can make anyone laugh.", "type": "example"}, {"content": "engenn10le10ob04aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "self-effacing", "type": "name"}, {"content": "humble; keeping yourself in the background", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: She always makes jokes about herself and her humor is very self-effacing.", "type": "example"}, {"content": "engenn10le10ob04aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "descriptive", "type": "name"}, {"content": "giving details about something", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: Her writing style is very descriptive.", "type": "example"}, {"content": "engenn10le10ob04aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "good sense of humor", "type": "name"}, {"content": "find things amusing rather than being serious all the time", "type": "definition"}, {"content": "(expression) ", "type": "part_speech"}, {"content": "Example: She has a very good sense of humor.", "type": "example"}, {"content": "engenn10le10ob04aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "big shot", "type": "name"}, {"content": "an important person", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: He is a multi-millionaire and a big shot.", "type": "example"}, {"content": "engenn10le10ob04aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "bend over backwards", "type": "name"}, {"content": "make a big effort", "type": "definition"}, {"content": "(expression) ", "type": "part_speech"}, {"content": "Example: I bent over backwards to make my parents comfortable during their visit.", "type": "example"}, {"content": "engenn10le10ob04aud07", "type": "audio"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I brainstorm a list of popular places for a first date.", "type": "text"}, {"content": "I interview my classmates and record their rankings and their reasons.", "type": "text"}, {"content": "I tabulate the results and report them to the class.", "type": "text"}, {"content": "I report responses that will help back up my findings.", "type": "text"}]}, {"type": "takeaway_extension", "contents": [{"content": "In pairs, come up with 8 good places for a first date.", "type": "text"}, {"content": "Put the best places for a first date at the top the worst at the bottom.", "type": "text"}, {"content": "Change partners several times and continue ranking your list.", "type": "text"}, {"content": "Ask reasons for their answers and record their responses.", "type": "text"}, {"content": "After, tabulate your results and report to the class your findings.", "type": "text"}, {"content": "Report classmates' responses in order to help back up your findings.", "type": "text"}]}]}