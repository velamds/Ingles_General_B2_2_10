back": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Read the dialogue and select all the sentences that express a present real situation in an if or when clause. ", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}]}], "id": 8, "stimuli_ids": []}, {"template_override": 1, "type": "TYP", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "when someone says", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "engenn10le10ob01re5aud01", "type": "audio"}, {"content": "What do you do", "type": "text"}]}, {"type": "post_question", "contents": {"content": "that?", "type": ""}}, {"content": "secondary_3", "type": "objective"}], "id": 0}, {"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "they often try", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "engenn10le10ob01re5aud02", "type": "audio"}, {"content": "When people have a problem with shyness,", "type": "text"}]}, {"type": "post_question", "contents": {"content": "online dating.", "type": ""}}, {"content": "secondary_3", "type": "objective"}], "id": 1}, {"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "go on a date", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "engenn10le10ob01re5aud03", "type": "audio"}, {"content": "If the person is nice, and you feel comfortable, then you", "type": "text"}]}, {"type": "post_question", "contents": {"content": ".", "type": ""}}, {"content": "secondary_3", "type": "objective"}], "id": 2}, {"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "is nothing on", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "engenn10le10ob01re5aud04", "type": "audio"}, {"content": "I look at my profile if there", "type": "text"}]}, {"type": "post_question", "contents": {"content": "T.V.", "type": ""}}, {"content": "secondary_3", "type": "objective"}], "id": 3}, {"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "try to arrange", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "engenn10le10ob01re5aud05", "type": "audio"}, {"content": "When I have a day off from work, I often", "type": "text"}]}, {"type": "post_question", "contents": {"content": "a date.", "type": ""}}, {"content": "secondary_3", "type": "objective"}], "id": 4}, {"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "rec"}]}, {"content": "secondary_3", "type": "objective"}], "id": 5}], "_data": [{"type": "instructions", "contents": [{"content": "Vanessa tells Peter about online dating.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 3", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Listening", "type": "skill"}, {"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: <span class=\"bullet\">Listen to the audio.</span> <span class=\"bullet\">Type in the missing words. </span><span class=\"bullet\">Record yourself saying the sentences aloud. </span><span class=\"bullet\">Compare yourself to the audio.</span>", "type": "text"}, {"content": " You have 2 attempts to submit your answers. ", "type": "text"}]}], "id": 9, "stimuli_ids": []}, {"template_override": 1, "type": "RSLT", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "DWS", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "engenn10le10ob01re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " The Online Dating Debate.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "id": 1, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn10le10ob01re2aud01", "coverimg": "engenn10le10ob01re2img01.jpg", "images": [{"image": "engenn10le10ob01re2img01.jpg", "text": "", "id": 0, "time": "0"}, {"image": "engenn10le10ob01re2img01.jpg", "text": "<span class=\"strong\">Peter</span>: V. I'm at the end of my rope. Last week's date was disastrous.\n</br><span class=\"strong\">Vanessa</span>:  Tell me what happened.\n</br><span class=\"strong\">Peter</span>: I met this girl for dinner. She was beautiful and bubbly and funny and I was \u2026 ugh!\n</br><span class=\"strong\">Vanessa</span>: You were \u2026 you?\n</br><span class=\"strong\">Peter</span>: Exactly. Painfully shy. The usual. I wish that I weren't so shy, but I was intimidated by her the minute she came into the room. I couldn't string together a sentence and I came off as super creepy. I wish I wasn't so easily rattled.\n</br><span class=\"strong\">Vanessa</span>: Oh. I'm sure it wasn't that bad.", "id": 1, "time": "100"}, {"image": "engenn10le10ob01re2img02.jpg", "text": "<span class=\"strong\">Peter</span>: She left early and today I got a text saying it was nice to meet me, but she felt there was no connection. What do you do when someone says that?\n</br><span class=\"strong\">Vanessa</span>: Nothing. I move on.\n</br><span class=\"strong\">Peter</span>: I wish I hadn't gone on that stupid date. I wish I hadn't called and I wish I had never asked her out. Uggh. I can't do this face to face dating thing.\n</br><span class=\"strong\">Vanessa</span>: Maybe you need to try online dating.\n</br><span class=\"strong\">Peter</span>: If I can't date normally, how am I supposed to date online?", "id": 2, "time": "35800"}, {"image": "engenn10le10ob01re2img05.jpg", "text": "<span class=\"strong\">Vanessa</span>: When people have a problem with shyness, they often try online dating because they don't have to meet until they get to know each other.\nIf the person is nice, and you feel comfortable, then you go on a date.\n</br><span class=\"strong\">Peter</span>: Have you ever done it?\n</br><span class=\"strong\">Vanessa</span>:  Sure. I have a profile and I'm talking to a few people online. I look at it if there is nothing on T.V. and  when I have a day off from work, I often try to arrange a date.\n</br><span class=\"strong\">Peter</span>: That sounds interesting.\n</br><span class=\"strong\">Vanessa</span>: Sure, lots of people are doing it. Do you want me to help you out?\n</br><span class=\"strong\">Peter</span>: That would be marvelous.", "id": 3, "time": "61500"}]}}], "_data": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "A Comedy of Errors", "type": "lesson_name"}, {"content": "Meeting People Online", "type": "unit_name"}, {"content": 1, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 10, "type": "lesson"}, {"content": "B2.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Exchange information about hypothetical situations in written and spoken interactions according to work and social contexts.", "type": "primary"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_1"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_2"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_3"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_4"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_5"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_6"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_7"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_8"}]}, {"content": "engenn10le10ob01re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Expressing Wishes About the Present", "type": "heading"}, {"content": "You use \u201c<span class=\"italic\">I wish</span> ...\u201d to talk about things you do not have or do, or you cannot have or do. </br>You use <span class=\"strong\">wish</span> + the past form of the verb or the past participle of the verb to talk about imaginary situations in the present.", "type": "describer"}, {"content": "The verb <span class=\"italic\">wish</span> introduces an idea. After <span class=\"italic\">wish</span>, you use a verb in the past tense.", "type": "text"}, {"content": "I wish I knew ... </br>I wish I had ... </br> I wish you were ... ", "type": "text"}, {"content": "Structure: </br> Wish + Simple Past tense", "type": "text"}, {"content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Example </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Meaning </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I wish that I weren't so shy.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I don't want to be so shy, but I am.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I wish I wasn't so easily rattled.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I don't want to be so easily rattled, but I am.\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}, {"content": "I wish that I weren't so shy.", "type": "example"}, {"content": "I wish I wasn't so easily rattled.", "type": "example"}, {"content": "I wish I hadn't gone on that stupid date. ", "type": "example"}, {"content": "I wish I hadn't called and I wish I had never asked her out.", "type": "example"}, {"content": "I wish I had more time to visit.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "The Present Real Conditional", "type": "heading"}, {"content": "The Present Real Conditional is used to talk about facts and truths. The condition is always possible and the result is generally expected to always be the same.", "type": "describer"}, {"content": "The Present Real Conditional is also called the Zero Conditional. </br>You use the structure: </br> <span class=\"italic\"><span class=\"strong\">If/when </span> ... Simple Present, ... Simple Present</br>  or </br>Simple Present ... <span class=\"strong\">if/when</span> ... Simple Present</span>", "type": "text"}, {"content": "The Present Real Conditional can be used with both <span class=\"italic\"> if</span> and <span class=\"italic\">when</span>. In this case, they have the same meaning.", "type": "text"}, {"content": "For example:  </br><span class=\"italic\">What do you do when someone says that? </span> </br> and</br> <span class=\"italic\">What do you do if someone says that? </span> </br> Both of these sentences have essentially the same meaning.", "type": "text"}, {"content": "The Zero or Real Conditional is formed using the <span class=\"strong\">Present Simple</span> tense, because the conditions and results are seen as facts or generalizations. ", "type": "text"}, {"content": "If the person is nice, and you feel comfortable, then you go on a date.", "type": "example"}, {"content": "I read a book only if there is nothing on T.V. ", "type": "example"}, {"content": "If people eat too much chocolate, they get fat.", "type": "example"}, {"content": "If they don't exercise at all, they won't be healthy.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "bubbly", "type": "name"}, {"content": "lively, cheerful", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: She is a very bubbly person.", "type": "example"}, {"content": "engenn10le10ob01aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about  someone's personality.   ", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to string together a sentence", "type": "name"}, {"content": "arrange a group of things into a series", "type": "definition"}, {"content": "(verb) ", "type": "part_speech"}, {"content": "Example: He can hardly string a sentence together.", "type": "example"}, {"content": "engenn10le10ob01aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "at the end of my rope", "type": "name"}, {"content": "to be very upset, or angry", "type": "definition"}, {"content": "(expression) ", "type": "part_speech"}, {"content": "Example: After losing all her money, she was at the end of her rope.", "type": "example"}, {"content": "engenn10le10ob01aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "disastrous", "type": "name"}, {"content": "causing great damage or stress", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: The rainstorm was disastrous for my garden.", "type": "example"}, {"content": "engenn10le10ob01aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "intimidated", "type": "name"}, {"content": "to feel frightened", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: I was intimidated by the very tall man.", "type": "example"}, {"content": "engenn10le10ob01aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "rattled", "type": "name"}, {"content": " to feel worried or nervous", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: I felt rattled after they started asking me tough questions.", "type": "example"}, {"content": "engenn10le10ob01aud06", "type": "audio"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I brainstorm ideas about online dating.", "type": "text"}, {"content": "I choose a side and build a case for that side through research and supporting points and examples.", "type": "text"}, {"content": "I  work with a partner and debate our position.", "type": "text"}, {"content": "I critique our performance.", "type": "text"}]}, {"type": "takeaway_extension", "contents": [{"content": "In pairs, write a list of the good and bad things about online dating.  ", "type": "text"}, {"content": "With your partner, choose a side (good or bad) you agree with the most.", "type": "text"}, {"content": "Come up with three supporting points. Go online to find ideas.", "type": "text"}, {"content": "Think of some examples to help support your points.", "type": "text"}, {"content": "Debate your position against another pair who has an opposing position.", "type": "text"}, {"content": "After the debate, decide which side had the stronger arguments and why.", "type": "text"}]}]}