: []}, {"template_override": 1, "type": "DWS", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "engenn10le10ob02re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Make a collage of my perfect match.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Writing", "type": "skill"}, {"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "stimuli": [{"template_override": 1, "_data": [], "type": "welcome", "contents": [{}], "id": 0}, {"template_override": 1, "_data": [], "type": "audio", "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn10le10ob02re2aud01", "coverimg": "engenn10le10ob02re2img05.jpg", "images": [{"image": "engenn10le10ob02re2img05.jpg", "text": "", "id": 0, "time": "0"}, {"image": "engenn10le10ob02re2img05.jpg", "text": "<span class=\"strong notdialogue\">Vanessa</span>: OK. Now that we have signed you up, let's look at some examples of what to write.\n</br><span class=\"strong notdialogue\">Peter</span>: OK.\n</br></br><span class=\"strong notdialogue\">\nWhat would you like to change about yourself?\n</span></br></br>\n<span class=\"strong notdialogue\">Vanessa:</span> Well, if I'm being honest, I wish my ears didn't stick out so much. And I guess I wish I had fuller lips. I'm a pretty good musician, but I really wish I could dance better. I enjoy parties and clubs, but I always feel a bit shy when I get out on the dance floor.\n</br><span class=\"strong notdialogue\">Peter</span>: Really? You're an okay dancer.\n</br><span class=\"strong notdialogue\">Vanessa</span>: There is always room for improvement.\n</br><span class=\"strong notdialogue\">Peter</span>: Let's see what else.", "id": 1, "time": "100"}, {"image": "engenn10le10ob02re2img01.jpg", "text": "<span class=\"strong notdialogue\">What physical qualities should your date possess?</span>\n</br></br></span><span class=\"strong notdialogue\">Vanessa</span>: Well, he's absolutely got to have a washboard stomach. And he needs to be tall. I mean, it really doesn't bother me if a guy is short, but I would prefer it if he were taller than me (in heels, of course!).\n</br></br><span class=\"strong notdialogue\">\nPeter</span>: Really? You have got to date Mr. abs?\n</br><span class=\"strong notdialogue\">Vanessa</span>: Hey. I'm a busy girl, so I don't have a lot of time to spend sifting through a bunch of flabby dudes I'm not going to contact. So the guy needs to be ripped! You have to specific.\n</br><span class=\"strong notdialogue\">Peter</span>: Cold blooded!", "id": 2, "time": "35600"}, {"image": "engenn10le10ob02re2img02.jpg", "text": "<span class=\"strong notdialogue\">What personal qualities should your date possess?\n</br></br></span>\n<span class=\"strong notdialogue\">Vanessa</span>: He should be sweet, but definitely not a pushover. He doesn't need to be well off, but it would be nice if he had a job. And he has to be spontaneous, I adore spontaneity in a man!\n</br></br><span class=\"strong notdialogue\">\nWhat is your ideal date?\n</br></br></span>\n<span class=\"strong notdialogue\">Vanessa</span>: I really wish I knew how to speak more languages, because my ideal dates all involve travel. I would especially love to go to the culinary hotspots, like Italy, Thailand, or France. An ideal date simply must include good food, accompanied by a glass of vintage red.\n</br></br><span class=\"strong notdialogue\">\nPeter</span>: Wow! You are high maintenance.\n</br><span class=\"strong notdialogue\">Vanessa</span>: Yep, but I am worth it.", "id": 3, "time": "69500"}]}}], "id": 1}], "type": "scholar", "id": 0, "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}], "_data": [{"type": "metadata", "contents": [{"content": "A Comedy of Errors", "type": "lesson_name"}, {"content": "Check out Her Profile!", "type": "unit_name"}, {"content": 2, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 10, "type": "lesson"}, {"content": "B2.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Exchange information about hypothetical situations in written and spoken interactions according to work and social contexts.", "type": "primary"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_1"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_2"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_3"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_4"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_5"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_6"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_7"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_8"}]}, {"content": "engenn10le10ob02re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Expressing Wishes About the Present and The Future", "type": "heading"}, {"content": "You use \u201c<span class=\"italic\">I wish ... </span>\u201d to talk about things you do not have or do, or you cannot have or do.</br> The verb<span class=\"italic\"> wish </span>introduces an idea. After<span class=\"italic\"> wish</span>, you use a verb in the past tense.", "type": "describer"}, {"content": "I wish I knew ...</br> I wish I had ... </br>I wish you were ...", "type": "text"}, {"content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Example </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Meaning </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I wish I had fuller lips.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I would like to have fuller lips, but it isn't possible.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I really wish I could dance better.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I would like to be a better dancer, but that seems very unlikely.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I really wish I knew how to speak more languages.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I would like to speak more languages, but I can't.\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}, {"content": "I wish my ears didn't stick out so much. ", "type": "example"}, {"content": " I guess I wish I had fuller lips. ", "type": "example"}, {"content": "I'm a pretty good musician, but I really wish I could dance better.", "type": "example"}, {"content": "I really wish I knew how to speak more languages.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Expressing Necessity", "type": "heading"}, {"content": "You use the modals <span class=\"italic\">must</span> and <span class=\"italic\">have (got) to</span> to express necessity in the past or in the present.", "type": "describer"}, {"content": "<span class=\"strong\">Must</span> refers to a necessary condition that comes from the subject and may be directed at the subject or the person the subject is talking to or about. It is used to express a strong necessity.", "type": "text"}, {"content": "<ul>Example: </br><span class=\"italic\">I must set up this online profile by tomorrow.</br>An ideal date must include good food.</span></ul>", "type": "text"}, {"content": "<span class=\"strong\">Have (got)  to </span>expresses obligations. These obligations come from a source other than the subject. They could be rules or regulations that the subject has no control over. You use  <span class=\"italic\">have got to </span> to show that necessity is not as strong  as with <span class=\"italic\">must.</span>", "type": "text"}, {"content": "<ul>Example: </br><span class=\"italic\">My ideal date has to be tall.</ul></span>", "type": "text"}, {"content": "When there is no obligation to do something, you use the <span class=\"strong\">negative form of have to</span>, not mustn't.", "type": "text"}, {"content": "<ul>Example: </br><span class=\"italic\">My ideal date doesn't have to be well off.</span></ul>", "type": "text"}, {"content": "<span class=\"italic\">Must</span> does not have a past form. When you want to use a past form for <span class=\"italic\">must</span>, choose  <span class=\"italic\">had to</span>.", "type": "text"}, {"content": "<ul>I had to finish some work, so I couldn't set up my online profile last night.</ul>", "type": "text"}, {"content": "He's absolutely got to have a washboard stomach.", "type": "example"}, {"content": "An ideal date simply must include good food.", "type": "example"}, {"content": "He has to be spontaneous.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "to sift", "type": "name"}, {"content": "to seperate; to look thoroughly so as to identify what you are looking for", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I sifted through the garbage looking for my ring.", "type": "example"}, {"content": "engenn10le10ob02aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use when you make a dating profile!", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "flabby", "type": "name"}, {"content": "soft and fat", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: My dad is starting to get a little flabby.", "type": "example"}, {"content": "engenn10le10ob02aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "ripped", "type": "name"}, {"content": "very muscular and toned", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": " Example: The personal trainer's body is ripped.", "type": "example"}, {"content": "engenn10le10ob02aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "cold-blooded", "type": "name"}, {"content": "deliberately cruel", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: Our boss fires people for no reason because he is cold blooded. ", "type": "example"}, {"content": "engenn10le10ob02aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "pushover", "type": "name"}, {"content": "A person who is easily persuaded", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: My brother is a pushover. You can convince him to do anything.", "type": "example"}, {"content": "engenn10le10ob02aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "spontaneous", "type": "name"}, {"content": "coming from a natural impulse", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: The spontaneous emotions of so many fans have  overwhelmed the internet.", "type": "example"}, {"content": "engenn10le10ob02aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "high maintenance", "type": "name"}, {"content": "demands a lot of attention", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: My cat is very high maintenance.", "type": "example"}, {"content": "engenn10le10ob02aud07", "type": "audio"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I research various people that have ideal features.", "type": "text"}, {"content": "I make a collage of the perfect face for my ideal mate.", "type": "text"}, {"content": "I explain my choices and my collage.", "type": "text"}, {"content": "I write 200 words describing my ideal partner's personality in detail.", "type": "text"}]}, {"type": "takeaway_extension", "contents": [{"content": "Look for  pictures of the faces of different people in a magazine or go online. ", "type": "text"}, {"content": "Print or cut out their best facial features and create the perfect face for a potential mate.", "type": "text"}, {"content": "Cut out your ideal nose, or a set of eyes you feel are perfect.", "type": "text"}, {"content": "In groups, explain your collage and whose features did you use and why did you pick those features.", "type": "text"}, {"content": "Write a 200 word paper describing your ideal partner in detail.", "type": "text"}, {"content": "Emphasize personality traits and characteristics and why you like those individual traits.", "type": "text"}]}]}