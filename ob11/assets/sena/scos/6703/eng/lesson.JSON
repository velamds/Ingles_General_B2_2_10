onses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Describe your ideal date on video!", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Writing", "type": "skill"}, {"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "type": "DWS", "template_override": 1}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "A Comedy of Errors", "type": "lesson_name"}, {"content": "Plenty of Fish", "type": "unit_name"}, {"content": 11, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 10, "type": "lesson"}, {"content": "B2.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Understand detailed descriptions of real or imaginary events and experiences in present, past or future and in spoken or written texts.", "type": "primary"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_1"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_2"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_3"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_4"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_5"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_6"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_7"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_8"}]}, {"content": "engenn10le10ob11re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Expressing Wishes and Regrets", "type": "heading"}, {"content": "You use <span class=\"strong\">I wish </span>or <span class=\"strong\">If only</span> ... to express wishes and regrets. </br>You use <span class=\"strong\">wish </span>+ <span class=\"strong\">would</span> + <span class=\"strong\">infinitive</span> to talk about things you would like to change about a situation or a person.", "type": "describer"}, {"content": "The verb <span class=\"italic\">wish </span>introduces an idea. After <span class=\"italic\">wish</span>, you use a verb in the past tense.", "type": "text"}, {"content": "Structure:  </br>Wish + Simple Past tense </br>Example:<span class=\"italic\"> I <span class=\"strong\">wish I wasn't</span> so busy.", "type": "text"}, {"content": "You use wish + would about other people who are doing (or not doing) something that you don't like and that you would like to change. You don't normally use it about yourself or about a situation that nobody can change.</br> Example: </br><span class=\"italic\">I <span class=\"strong\">wish my sorrows would drown </span>after a long swim!</span>", "type": "text"}, {"content": "You use expressions like<span class=\"italic\"> If only </span>... to express wishes in the present or regret about a past action.", "type": "text"}, {"content": "Structure: </br>If only ... + Simple Past tense = wish </br>If only ... + Past Perfect = regret  </br></br><span class=\"italic\"><span class=\"strong\">If only you had told </span>me that you wanted to get that certificate!</span>", "type": "text"}, {"content": "I wish I didn't need a ride home.", "type": "example"}, {"content": " I wish they would drown.", "type": "example"}, {"content": "I wish I had told you that.", "type": "example"}, {"content": "If only you weren't so wholesome.", "type": "example"}, {"content": "If only we weren't so busy.", "type": "example"}, {"content": "If only I were finished.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Expressing Necessity and Absence of Necessity ", "type": "heading"}, {"content": "You use the modals <span class=\"italic\">must</span> and <span class=\"italic\">have (got) to</span> to express necessity. </br>You use the negative forms of the modals <span class=\"italic\">need to</span> and <span class=\"italic\">have to</span> to express absence of necessity.", "type": "describer"}, {"content": "<span class=\"strong\">Must </span>refers to a necessary condition that comes from the subject and may be directed at the subject or the person the subject is talking to or about. It is used to express a strong necessity.   <ul>Example:  </br><span class=\"italic\">I must set up this online profile by tomorrow.</br> An ideal date must include good food.</span>", "type": "text"}, {"content": "<span class=\"strong\">Have (got)  to </span>expresses external obligations. These do not come from the subject, but from a source outside it. These may be rules and regulations over which the subject has no control. It is used to express necessity in a lower degree than with <span class=\"italic\">must.</span>", "type": "text"}, {"content": "You use the <span class=\"strong\">negative form of have to</span> to show an absence of necessity. You do not use mustn't.</br> Example: <ul><span class=\"italic\">My ideal date doesn't have to be well off.</span></ul>", "type": "text"}, {"content": "Absence of necessity can also be expressed by the negative form of <span class=\"italic\">need</span>. It is generally used as a main verb in the construction <span class=\"italic\">don't need to</span>, but sometimes can be used as a modal, like <span class=\"italic\">needn't</span>. The infinitive after the modal verb \"needn't\" is used without the particle \"to\".  </br>Compare these sentences:</br><span class=\"italic\"></br> You don't need to rush into a relationship right now.</br> You needn't rush into a relationship right now.</span>", "type": "text"}, {"content": "To express absence of necessity in the future, you use the structure: subject + won't + have/need + infinitive.", "type": "text"}, {"content": "Example:</br> <span class=\"italic\">You <span class=\"strong\">won't have to worry</span> about online dating once you get married.</br>If you set up your online profile properly, you <span class=\"strong\">won't need to sift </span>through tons of irrelevant messages.</span>", "type": "text"}, {"content": "To express absence of necessity in the past, you use the structure: subject +  didn't  +  have/need  + infinitive.", "type": "text"}, {"content": "Example:</br><span class=\"italic\"><span class=\"strong\"> You didn't have to get </span>so upset last night. </br><span class=\"strong\">She didn't need to check </span>her phone constantly during dinner.</span>", "type": "text"}, {"content": "Here is a list of modals of necessity:", "type": "text"}, {"content": "{\"rows\":5,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Modal\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"have to\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"necessity/lack of necessity (negative)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">You have to tell her. You don't have to make a reservation.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"must\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"strong necessity/prohibition (negative)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">We must meet after eight.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"ought to\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"strong advisability\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">You  ought to tell her that you're not into her.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"should \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"strong advisability\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">You should have set this girl straight a long time ago.</span>\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}, {"content": "You don't have to drink it. ", "type": "example"}, {"content": "I have to be certified in order to be a life coach. ", "type": "example"}, {"content": "I must also get this other certificate.", "type": "example"}, {"content": " I think I have to go home. I have to finish this.", "type": "example"}, {"content": " You ought to give me your phone number.", "type": "example"}, {"content": "You don't have to, here's my card.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "wholesome", "type": "name"}, {"content": "moral and good", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: She is a very wholesome person.", "type": "example"}, {"content": "engenn10le10ob11aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use if you meet an old friend.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "tad", "type": "name"}, {"content": "a little", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: I am a tad over 200 lbs.", "type": "example"}, {"content": "engenn10le10ob11aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "big shot", "type": "name"}, {"content": "important person", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: He is a millionaire and a real big shot in the city.", "type": "example"}, {"content": "engenn10le10ob11aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "a comedy of errors", "type": "name"}, {"content": "many mistakes", "type": "definition"}, {"content": "(expression) ", "type": "part_speech"}, {"content": "Example: Both teams played so badly. It was a comedy of errors.", "type": "example"}, {"content": "engenn10le10ob11aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "overboard", "type": "name"}, {"content": "to go to extreme", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: I cooked way too much food. I really went overboard.", "type": "example"}, {"content": "engenn10le10ob11aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "second thoughts", "type": "name"}, {"content": "after reconsideration", "type": "definition"}, {"content": "(no